    "q3_freezing_vs_mild": {
      "question": "How many freezing nights (temp_min \u2264 0\u00b0C) occurred per winter-ish month, and what was the average daily temperature range on those days?",
      "sql": "SELECT year, month,\n                   SUM(CASE WHEN is_freezing THEN 1 ELSE 0 END) AS freezing_nights,\n                   COUNT(*) AS n_days,\n                   ROUND(\n                     AVG(CASE WHEN is_freezing THEN temp_range_c END), 2\n                   ) AS avg_range_on_freezing_days_c,\n                   ROUND(AVG(temp_range_c), 2) AS avg_range_all_days_c\n            FROM daily_weather\n            WHERE month IN (11, 12, 1, 2, 3)\n            GROUP BY year, month\n            ORDER BY year, month",
      "rows": [
        {
          "year": 2023,
          "month": 1,
